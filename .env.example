# Copy to .env and fill in. Never commit .env.
# Real values for production live in the Vercel and Railway dashboards.

# ── shared (web + worker) ─────────────────────────────
# Neon connection string (use the pooled one for web, direct is fine for the worker)
DATABASE_URL=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── web only ──────────────────────────────────────────
# production: https://keepmint.store
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Sentry project "keepmint-web" (used by the browser and the server)
NEXT_PUBLIC_SENTRY_DSN=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=
# e.g. Keepmint <hello@keepmint.store>
EMAIL_FROM=

# ── worker only — never put these in the web app ──────
ANTHROPIC_API_KEY=
# Sentry project "keepmint-worker"
SENTRY_DSN=
