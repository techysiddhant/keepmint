    "@sentry/node": "11.10.0",
    "aws4fetch": "1.0.20",
    "dotenv": "18.0.9",
    "linkedom": "0.18.15",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "tsx": "4.23.15",
    "undici": "7.30.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
